# Supabase (project: jdm-kingdom-ebay)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# eBay Developer application keys — developer.ebay.com > My Account > Application Keys
EBAY_ENV=sandbox            # sandbox | production — start on sandbox, flip once verified
EBAY_CLIENT_ID=             # "App ID (Client ID)"
EBAY_CLIENT_SECRET=         # "Cert ID (Client Secret)"
EBAY_RU_NAME=                # the RuName redirect configured in the eBay dev portal
EBAY_SITE_ID=15              # eBay site ID — 15 = Australia

# Marketplace Account Deletion notification endpoint (required for production keys)
# EBAY_VERIFICATION_TOKEN: any string 32-80 chars you invent, registered in the dev portal alongside the endpoint URL below.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=https://<your-vercel-domain>/api/ebay/deletion

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` — set once a custom cron secret is configured in Vercel project settings.
CRON_SECRET=
